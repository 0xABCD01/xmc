load("@io_bazel_rules_go//go:def.bzl", "go_test")

# Tests for the stable-2026b profile meta-chart: the generic profilecontract checks plus
# stable-2026b expectations. The stable-2026a chart is data because metadata-only stable-2026b
# entries must match the stable-2026a charts that xmc-bridge falls back to.
go_test(
    name = "stable2026b_test",
    srcs = ["profile_chart_test.go"],
    data = [
        "//deploy/profiles/stable-2026a:chart",
        "//deploy/profiles/stable-2026b:chart",
    ],
    deps = [
        "//deploy/profiles/stable-2026b:stable2026b",
        "//test/helm/profiles/profilecontract",
        "@com_github_google_go_cmp//cmp",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)
